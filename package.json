{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{js,ts,vue}": [
      "cd frontend/nuxt-app && npx eslint --fix --max-warnings=0",
      "cd frontend/nuxt-app && npx prettier --write --ignore-unknown"
    ],
    "frontend/**/*.{json,md}": [
      "cd frontend/nuxt-app && npx prettier --write --ignore-unknown"
    ]
  }
}
