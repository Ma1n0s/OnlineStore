echo "Running pre-commit hook..."
echo "Current directory: $(pwd)"

# Проверяем, есть ли измененные файлы во frontend
if git diff --cached --name-only | grep -q "^frontend/"; then
  echo "Checking frontend files..."
  cd frontend/nuxt-app && npx lint-staged --debug
else
  echo "No frontend files changed, skipping lint-staged"
fi 