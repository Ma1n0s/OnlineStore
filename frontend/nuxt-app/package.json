{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "jest": "jest",
    "test": "jest",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cypress:run",
    "test:e2e:open": "start-server-and-test dev http://localhost:3000 cypress:open",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "husky",
    "lint": "eslint . --ext js,ts,vue --ignore-pattern .nuxt --ignore-pattern .output --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"**/*.{js,ts,vue,json,md}\" --ignore-path .gitignore"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix --ignore-pattern .nuxt --ignore-pattern .output",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nuxt/icon": "^1.11.0",
    "@nuxt/image": "^1.10.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/robots": "^5.2.8",
    "@nuxtjs/seo": "^3.0.1",
    "@nuxtjs/sitemap": "^7.2.9",
    "@pinia/nuxt": "^0.10.1",
    "@popperjs/core": "^2.11.8",
    "@samk-dev/nuxt-vcalendar": "^1.0.4",
    "@vueuse/nuxt": "^13.0.0",
    "axios": "^1.9.0",
    "nuxt": "^3.16.0",
    "nuxt-aos": "^1.2.5",
    "nuxt-auth-sanctum": "^0.6.3",
    "nuxt-swiper": "^2.0.0",
    "pinia": "^3.0.1",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.24.0",
    "@iconify-json/material-symbols": "^1.2.16",
    "@iconify-json/tabler": "^1.2.17",
    "@nuxt/test-utils": "^3.17.2",
    "@nuxtjs/tailwindcss": "^6.13.2",
    "@percy/cli": "^1.30.7",
    "@testing-library/cypress": "^10.0.3",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^3.1.1",
    "@vue/test-utils": "^2.4.6",
    "babel-jest": "^29.7.0",
    "cypress": "^14.2.1",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.0.0",
    "fluid-tailwind": "^1.0.4",
    "globals": "^16.0.0",
    "happy-dom": "^17.4.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "start-server-and-test": "^2.0.11",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "vitest": "^3.1.1"
  }
}
